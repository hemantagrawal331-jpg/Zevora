# Public Supabase project URL, for example https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. This may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Used in auth email links. No trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty until a payment provider is connected. The webhook does nothing without it.
PAYMENT_WEBHOOK_SECRET=
# Set to true only when Supabase Image Transformations are enabled.
SUPABASE_IMAGE_TRANSFORMS=false

# Existing sourcing workspace. Unrelated to Supabase Auth.
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
