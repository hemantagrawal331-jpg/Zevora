# Public Supabase project URL, for example https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. This may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Used in auth email links. No trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty. The previous custom webhook secret is not used.
# Razorpay webhooks use RAZORPAY_WEBHOOK_SECRET.
PAYMENT_WEBHOOK_SECRET=
# Server-only Razorpay key id, for example rzp_test_...
# Use Test Mode until the test flow has passed. Do not put the key secret here with a NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_ID=
# Optional. If set, it must match RAZORPAY_KEY_ID. Checkout receives the public key from the server.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server only. Used to verify the checkout signature. Never prefix with NEXT_PUBLIC_.
RAZORPAY_KEY_SECRET=
# Server only. Used to verify Razorpay webhooks. This is not the key secret.
RAZORPAY_WEBHOOK_SECRET=
# Set to true only when Supabase Image Transformations are enabled.
SUPABASE_IMAGE_TRANSFORMS=false

# Existing sourcing workspace. Unrelated to Supabase Auth.
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
